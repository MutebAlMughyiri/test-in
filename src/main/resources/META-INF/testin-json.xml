<!-- Loaded only when JSON support is present. Testin's marker files are
     JSON named only by their extension - .ts, .tr - which the IDE would
     otherwise read as TypeScript and cover in errors. The names are the
     markers NodeType declares; JsonMarkerNamesTest keeps them equal. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="JSON"
                  fileNames=".testproject;.testcasesfolder;.testrunsfolder;.testsetpackage;.testrunpackage;.testset;.testrun"/>
    </extensions>
</idea-plugin>
